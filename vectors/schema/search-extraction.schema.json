{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/vectors/schema/search-extraction.schema.json",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "title": "The extraction cases (SEARCH.md section 11), vectors/search/extraction.json",
  "type": "object",
  "required": [
    "v",
    "now",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 2
    },
    "now": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "store",
          "queries"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "store": {
            "type": "object",
            "required": [
              "collections",
              "items",
              "references"
            ],
            "additionalProperties": false,
            "properties": {
              "collections": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/collection"
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "references": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                }
              },
              "properties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/property"
                }
              }
            }
          },
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/query"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "required": [
        "id",
        "account",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "message/rfc822",
            "text/vcard",
            "text/calendar",
            "application/octet-stream"
          ]
        },
        "role": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "covered_since",
              "covered_until",
              "covered_at"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "covered_since": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "covered_until": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "covered_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "event_summary": {
      "type": "object",
      "required": [
        "uid",
        "summary",
        "location",
        "dtstart",
        "dtstart_tzid",
        "dtstart_value",
        "dtend",
        "recurring",
        "until"
      ],
      "additionalProperties": false,
      "properties": {
        "uid": {
          "$ref": "#/$defs/maybe"
        },
        "summary": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/maybe"
        },
        "dtstart": {
          "$ref": "#/$defs/maybe"
        },
        "dtstart_tzid": {
          "$ref": "#/$defs/maybe"
        },
        "dtstart_value": {
          "enum": [
            "date-time",
            "date",
            null
          ]
        },
        "dtend": {
          "$ref": "#/$defs/maybe"
        },
        "recurring": {
          "enum": [
            0,
            1,
            null
          ]
        },
        "until": {
          "$ref": "#/$defs/maybe"
        }
      }
    },
    "file_summary": {
      "type": "object",
      "required": [
        "name",
        "media_type",
        "size",
        "part"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "media_type": {
          "$ref": "#/$defs/maybe"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "part": {
          "$ref": "#/$defs/maybe"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "collection",
        "seq",
        "link_id",
        "flags"
      ],
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "link_id": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[!-~]+$"
          }
        },
        "fixture": {
          "type": "string",
          "pattern": "^fixtures/"
        },
        "unreadable": {
          "const": true
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      },
      "oneOf": [
        {
          "required": [
            "fixture"
          ]
        },
        {
          "required": [
            "summary"
          ]
        }
      ],
      "dependentRequired": {
        "unreadable": [
          "fixture"
        ]
      }
    },
    "mail_summary": {
      "type": "object",
      "required": [
        "message_id",
        "in_reply_to",
        "subject",
        "sender",
        "sender_name",
        "date",
        "size",
        "attachment",
        "invitation"
      ],
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "$ref": "#/$defs/maybe"
        },
        "in_reply_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/maybe"
        },
        "sender_name": {
          "$ref": "#/$defs/maybe"
        },
        "date": {
          "$ref": "#/$defs/maybe"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "attachment": {
          "enum": [
            0,
            1,
            null
          ]
        },
        "invitation": {
          "$ref": "#/$defs/maybe"
        }
      }
    },
    "maybe": {
      "type": [
        "string",
        "null"
      ]
    },
    "property": {
      "type": "object",
      "required": [
        "seq",
        "key",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "message/rfc822",
          "text/vcard",
          "text/calendar"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "bodiless",
          "missing",
          "unparseable",
          "encrypted"
        ],
        "additionalProperties": false,
        "properties": {
          "bodiless": {
            "$ref": "#/$defs/count"
          },
          "missing": {
            "$ref": "#/$defs/count"
          },
          "unparseable": {
            "$ref": "#/$defs/count"
          },
          "encrypted": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": 1
          }
        ],
        "items": false,
        "minItems": 2
      }
    },
    "matched": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "enum": [
              "body",
              "summary"
            ]
          }
        ],
        "items": false,
        "minItems": 3
      }
    },
    "query": {
      "type": "object",
      "required": [
        "query",
        "hits"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "zone": {
          "type": "string",
          "minLength": 1
        },
        "index_zone": {
          "type": "string",
          "minLength": 1
        },
        "now": {
          "type": "string"
        },
        "sort": {
          "enum": [
            "newest-first",
            "oldest-first",
            "title",
            "sender",
            "relevance"
          ]
        },
        "ordered": {
          "const": true
        },
        "hits": {
          "$ref": "#/$defs/hits"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "complete": {
          "type": "boolean"
        },
        "matched": {
          "$ref": "#/$defs/matched"
        }
      },
      "dependentRequired": {
        "index_zone": [
          "zone"
        ],
        "matched": [
          "hits"
        ]
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "from_kind",
        "from_link_id",
        "to_kind",
        "to_link_id",
        "role",
        "origin"
      ],
      "additionalProperties": false,
      "properties": {
        "from_kind": {
          "type": "string"
        },
        "from_link_id": {
          "type": "string"
        },
        "to_kind": {
          "type": "string"
        },
        "to_link_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "auto",
            "user"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "table",
        "row",
        "addresses",
        "sort_key"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "enum": [
            "mail_summary",
            "file_summary",
            "event_summary"
          ]
        },
        "row": {
          "type": "object"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "position",
              "address",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "from",
                  "to",
                  "cc",
                  "bcc",
                  "email",
                  "organizer",
                  "attendee",
                  "contact"
                ]
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "address": {
                "type": "string"
              },
              "name": {
                "$ref": "#/$defs/maybe"
              }
            }
          }
        },
        "sort_key": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "table": {
                "const": "mail_summary"
              }
            }
          },
          "then": {
            "properties": {
              "row": {
                "$ref": "#/$defs/mail_summary"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "table": {
                "const": "file_summary"
              }
            }
          },
          "then": {
            "properties": {
              "row": {
                "$ref": "#/$defs/file_summary"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "table": {
                "const": "event_summary"
              }
            }
          },
          "then": {
            "properties": {
              "row": {
                "$ref": "#/$defs/event_summary"
              }
            }
          }
        }
      ]
    }
  }
}
