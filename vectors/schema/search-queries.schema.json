{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/vectors/schema/search-queries.schema.json",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "title": "The search cases (SEARCH.md section 11), vectors/search/queries.json",
  "type": "object",
  "required": ["v", "now", "horizon", "coverage", "cases", "occurrences"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 3 },
    "now": { "type": "string" },
    "horizon": { "type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": { "start": { "type": "string" }, "end": { "type": "string" } } },
    "coverage": {
      "type": "object",
      "propertyNames": { "enum": ["message/rfc822", "text/vcard", "text/calendar", "application/octet-stream"] },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "note": { "type": "string" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "rows"],
        "additionalProperties": false,
        "properties": {
          "start": { "type": "string" },
          "end": { "type": "string" },
          "rows": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "integer" }, { "type": "string" }, { "type": "string" }], "items": false, "minItems": 4 } },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "hits": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "integer", "minimum": 1 }], "items": false, "minItems": 2 } },
    "case": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string" },
        "note": { "type": "string" },
        "zone": { "type": "string", "minLength": 1 },
        "now": { "type": "string" },
        "sort": { "enum": ["date", "name", "relevance"] },
        "ordered": { "const": true },
        "hits": { "$ref": "#/$defs/hits" },
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["thread", "count", "first", "last", "hits"],
            "additionalProperties": false,
            "properties": {
              "thread": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "first": { "type": "string" },
              "last": { "type": "string" },
              "hits": { "$ref": "#/$defs/hits" }
            }
          }
        },
        "error": {
          "type": "object",
          "required": ["code", "start", "end"],
          "additionalProperties": false,
          "properties": {
            "code": { "enum": ["empty-query", "unknown-field", "invalid-value", "invalid-date", "unterminated-phrase", "unbalanced-parenthesis", "dangling-operator", "invalid-wildcard", "limit-exceeded"] },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 }
          }
        },
        "horizon_left": { "const": true },
        "temporal": {
          "oneOf": [
            { "const": "full" },
            {
              "type": "object",
              "required": ["since", "until", "filling"],
              "additionalProperties": false,
              "properties": { "since": { "type": ["string", "null"] }, "until": { "type": ["string", "null"] }, "filling": { "type": "boolean" } }
            }
          ]
        },
        "cut": { "type": "integer", "minimum": 0 }
      },
      "oneOf": [{ "required": ["hits"] }, { "required": ["threads"] }, { "required": ["error"] }]
    }
  }
}
