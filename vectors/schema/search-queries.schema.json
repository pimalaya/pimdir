{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/vectors/schema/search-queries.schema.json",
  "title": "The search cases (SEARCH.md section 11), vectors/search/queries.json",
  "type": "object",
  "required": ["v", "now", "horizon", "coverage", "cases"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "now": { "type": "string" },
    "horizon": { "type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": { "start": { "type": "string" }, "end": { "type": "string" } } },
    "coverage": { "type": "object", "additionalProperties": { "type": "integer" } },
    "note": { "type": "string" },
    "cases": { "type": "array", "items": { "type": "object", "required": ["query"] } }
  }
}
