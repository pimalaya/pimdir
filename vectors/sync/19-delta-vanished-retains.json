{
  "label": "a delta listing a handle as vanished drops it and retains the item",
  "note": "an incomplete enumeration says nothing about the members it does not list; the ones it lists vanished are dropped Deleted, and the last binding going retains the row (SYNC.md §5, STORAGE §11)",
  "store": {
    "collections": [{ "id": "INBOX", "account": null, "kind": "message/rfc822", "conflict": "manual" }],
    "objects": {
      "m1": { "body": "fixtures/mail-basic.eml" }
    },
    "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 0 }],
    "bindings": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "10", "base_flags": ["\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 }],
    "probes": [],
    "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c0" }]
  },
  "run": {
    "verb": "sync",
    "collection": "INBOX",
    "source": "imap",
    "options": {
      "push": true,
      "rights": { "flags": true, "content": true, "add": true, "remove": true },
      "conflict": "manual"
    }
  },
  "remote": {
    "snapshot": { "items": [], "vanished": ["10"], "complete": false, "checkpoint": "c1" },
    "fetch": {}
  },
  "expect": {
    "pushes": [],
    "outcomes": [],
    "events": [{ "kind": "Vanished", "handle": "10" }],
    "store": {
      "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 1, "retained": true, "retained_by": "imap" }],
      "bindings": [],
      "probes": [],
      "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c1" }]
    }
  }
}
