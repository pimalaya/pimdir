{
  "v": 1,
  "label": "a tombstone an add superseded pushes no delete while the add's create is pending",
  "note": "task todo-inbox was filed from tasks-a into tasks-b as an add carrying supersedes; tasks-b's create is still pending, its server having refused it or tasks-b not synced yet, so tasks-a's tombstone is held: the listed member derives no Remove, nothing is dropped, and the task stays on the server (STORAGE §15.3, SYNC.md §5)",
  "store": {
    "collections": [
      { "id": "tasks-a", "account": null, "kind": "text/calendar", "conflict": "manual" },
      { "id": "tasks-b", "account": null, "kind": "text/calendar", "conflict": "manual" }
    ],
    "objects": {
      "t1": { "body": "fixtures/todo-inbox.ics" },
      "t2": { "body": "fixtures/todo-waiting.ics" }
    },
    "items": [
      { "collection": "tasks-a", "link_id": "todo-inbox@example.org", "seq": 1, "flags": [], "object": "t1", "level": 2, "deleted": 1 },
      { "collection": "tasks-b", "link_id": "todo-waiting@example.org", "seq": 2, "flags": [], "object": "t2", "level": 2, "deleted": 0 }
    ],
    "bindings": [
      { "collection": "tasks-a", "link_id": "todo-inbox@example.org", "source": "caldav", "handle": "inbox.ics", "base_flags": [], "base_object": "t1", "base_revision": "r1", "base_present": 1 },
      { "collection": "tasks-b", "link_id": "todo-waiting@example.org", "source": "caldav", "handle": "\u0001todo-waiting@example.org", "base_flags": null, "base_object": null, "base_revision": null, "base_present": 0 }
    ],
    "supersessions": [
      { "collection": "tasks-a", "link_id": "todo-inbox@example.org", "by_collection": "tasks-b", "by_link_id": "todo-waiting@example.org" }
    ],
    "sources": [
      { "collection": "tasks-a", "source": "caldav", "checkpoint": "a0" },
      { "collection": "tasks-b", "source": "caldav", "checkpoint": "b0" }
    ]
  },
  "run": {
    "verb": "sync",
    "collection": "tasks-a",
    "source": "caldav",
    "options": {
      "push": true,
      "rights": { "flags": true, "content": true, "add": true, "remove": true },
      "conflict": "manual"
    }
  },
  "remote": {
    "snapshot": {
      "items": [{ "handle": "inbox.ics", "flags": [], "revision": "r1", "meta": { "body": "fixtures/todo-inbox.ics" } }],
      "vanished": [],
      "complete": true,
      "checkpoint": "a1"
    },
    "fetch": {}
  },
  "expect": {
    "pushes": [],
    "outcomes": [],
    "events": [],
    "store": {
      "items": [
        { "collection": "tasks-a", "link_id": "todo-inbox@example.org", "seq": 1, "flags": [], "object": "t1", "level": 2, "deleted": 1 },
        { "collection": "tasks-b", "link_id": "todo-waiting@example.org", "seq": 2, "flags": [], "object": "t2", "level": 2, "deleted": 0 }
      ],
      "bindings": [
        { "collection": "tasks-a", "link_id": "todo-inbox@example.org", "source": "caldav", "handle": "inbox.ics", "base_flags": [], "base_object": "t1", "base_revision": "r1", "base_present": 1 },
        { "collection": "tasks-b", "link_id": "todo-waiting@example.org", "source": "caldav", "handle": "\u0001todo-waiting@example.org", "base_flags": null, "base_object": null, "base_revision": null, "base_present": 0 }
      ],
      "supersessions": [
        { "collection": "tasks-a", "link_id": "todo-inbox@example.org", "by_collection": "tasks-b", "by_link_id": "todo-waiting@example.org" }
      ],
      "sources": [
        { "collection": "tasks-a", "source": "caldav", "checkpoint": "a1" },
        { "collection": "tasks-b", "source": "caldav", "checkpoint": "b0" }
      ]
    }
  }
}
