{
  "v": 7,
  "label": "a tombstone over a conflicted binding pushes no remove: the server edit its conflict holds beats the delete",
  "note": "the card was edited locally to c2 while dav's server moved it to r2, and the binding recorded that conflict, the diverging body not yet read. Another source then stated the card removed, so the item is deleted and dav projects a Tombstone, carrying its binding's conflict, a delete elsewhere settling nothing here. The binding's conflict_revision is a server edit past its base, which beats the delete: the delta does not list the card again, and the run still derives no Remove. Holding the local edit too, the tombstone is the both-changed case and follows the policy, so under manual the card is revived and stays conflicted at r2 (SYNC.md §3, §5, §9)",
  "store": {
    "collections": [{ "id": "Contacts", "account": null, "kind": "text/vcard", "conflict": "manual" }],
    "objects": {
      "c1": { "body": "fixtures/card-basic.vcf" },
      "c2": { "body": "fixtures/card-basic-edited.vcf" }
    },
    "items": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 1 }],
    "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c1", "base_revision": "r1", "base_present": 1, "conflicted": 1, "conflict_revision": "r2", "conflict_object": null }],
    "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d1" }, { "collection": "Contacts", "source": "other", "checkpoint": "o1" }]
  },
