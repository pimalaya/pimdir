      "c2": { "body": "fixtures/card-basic-edited.vcf" }
    },
    "items": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 }],
    "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c1", "base_revision": "r1", "base_present": 1, "refusal": "the server refuses this card as it stands", "refused_key": "70dff76eb227a5cd" }],
    "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d0" }]
  },
  "run": {
