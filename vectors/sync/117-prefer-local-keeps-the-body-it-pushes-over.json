{
  "v": 2,
  "label": "both sides edited under prefer-local, the member carrying its body, keeps that body and pushes the local one over it",
  "note": "the server moved to r2 and its listing carries the body, c3, as a DAV multiget does. prefer-local settles for c2, but c3 is a body someone wrote: in a write committed before the push, the base adopts c3 at r2 and c3 is kept as a retained item under the key minted over the handle, reported Overruled; the push of c2 is then gated on r2, accepted at r3, and the base moves to c2. A push rejected or replayed finds c3 kept and the base on it, keeping nothing twice (SYNC.md §5, §9; STORAGE §11)",
  "store": {
    "collections": [{ "id": "Contacts", "account": null, "kind": "text/vcard", "conflict": "manual" }],
    "objects": { "c1": { "body": "fixtures/card-basic.vcf" }, "c2": { "body": "fixtures/card-basic-edited.vcf" }, "c3": { "body": "fixtures/card-basic-renamed.vcf" } },
    "items": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 }],
    "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c1", "base_revision": "r1", "base_present": 1 }],
    "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d0" }]
  },
  "run": { "verb": "sync", "collection": "Contacts", "source": "dav", "options": { "push": true, "rights": { "flags": true, "content": true, "add": true, "remove": true }, "conflict": "prefer-local" } },
  "remote": {
    "snapshot": {
      "items": [{ "handle": "a.vcf", "flags": [], "revision": "r2", "carries": true, "meta": { "body": "fixtures/card-basic-renamed.vcf" } }],
      "vanished": [],
      "complete": true,
      "checkpoint": "d1"
    },
    "fetch": {}
  },
  "expect": {
    "pushes": [{ "kind": "Update", "handle": "a.vcf", "object": "c2", "if_match": "r2", "key": "807e1f03afcfd042" }],
    "outcomes": [{ "handle": "a.vcf", "outcome": "Accepted", "revision": "r3" }],
    "events": [{ "kind": "Overruled", "handle": "a.vcf", "link_id": "dup:urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40#a.vcf" }],
    "store": {
      "items": [
        { "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 },
        { "collection": "Contacts", "link_id": "dup:urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40#a.vcf", "seq": 2, "flags": [], "object": "c3", "level": 2, "deleted": 1, "retained": true, "retained_by": "dav" }
      ],
      "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c2", "base_revision": "r3", "base_present": 1 }],
      "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d1" }]
    }
  }
}
