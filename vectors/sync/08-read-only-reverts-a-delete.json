{
  "label": "a read-only source reverts a local delete it can never push",
  "note": "with push false the tombstone is undone and the row lands clean, keeping its body; holding it would hide a member an incremental source never lists again (SYNC.md §5)",
  "store": {
    "collections": [{ "id": "INBOX", "account": null, "kind": "message/rfc822", "conflict": "manual" }],
    "objects": { "m1": { "body": "fixtures/mail-basic.eml" } },
    "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 1 }],
    "bindings": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "10", "base_flags": ["\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 }],
    "probes": [],
    "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c0" }]
  },
  "run": { "verb": "sync", "collection": "INBOX", "source": "imap", "options": { "push": false, "rights": { "flags": true, "content": true, "add": true, "remove": true }, "conflict": "manual", "delete": "revert" } },
  "remote": { "snapshot": { "items": [], "vanished": [], "complete": false, "checkpoint": "c1" }, "fetch": {} },
  "expect": {
    "pushes": [],
    "outcomes": [],
    "events": [],
    "store": {
      "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 0 }],
      "bindings": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "10", "base_flags": ["\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 }],
      "probes": [],
      "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c1" }]
    }
  }
}
