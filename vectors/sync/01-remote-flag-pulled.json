{
  "label": "a remote flag change is pulled, nothing is pushed",
  "note": "local equals base, so the remote's added flag wins the three-way merge and the base follows it (SYNC.md §5)",
  "store": {
    "collections": [{ "id": "INBOX", "account": null, "kind": "message/rfc822", "conflict": "manual" }],
    "objects": { "m1": { "body": "fixtures/mail-basic.eml" } },
    "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 0 }],
    "bindings": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "10", "base_flags": ["\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 }],
    "probes": [],
    "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c0" }]
  },
  "run": { "verb": "sync", "collection": "INBOX", "source": "imap", "options": { "push": true, "rights": { "flags": true, "content": true, "add": true, "remove": true }, "conflict": "manual", "delete": "revert" } },
  "remote": { "snapshot": { "items": [{ "handle": "10", "flags": ["\\Flagged", "\\Seen"], "revision": null }], "vanished": [], "complete": true, "checkpoint": "c1" }, "fetch": {} },
  "expect": {
    "pushes": [],
    "outcomes": [],
    "events": [{ "kind": "FlagsChanged", "handle": "10" }],
    "store": {
      "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Flagged", "\\Seen"], "object": "m1", "level": 2, "deleted": 0 }],
      "bindings": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "10", "base_flags": ["\\Flagged", "\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 }],
      "probes": [],
      "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c1" }]
    }
  }
}
