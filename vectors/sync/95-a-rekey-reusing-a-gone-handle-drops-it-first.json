{
  "v": 1,
  "label": "a rekey whose new handles restart at 1 drops the gone member's binding before any upsert reuses its handle",
  "note": "the server bumped UIDVALIDITY and numbered from 1 again: the stand-up notes, which held 1, are gone, and the agenda and the attachment message, which held 2 and 3, now hold 1 and 2. Absence is by link id, not by handle: basic-1@example.org resolves to no member, so its binding is dropped Deleted although the new space reuses its handle, and the drop precedes every upsert, else the agenda's upsert under 1 would fold into the stand-up notes' item. The two others carry their flags onto their new handles, the gone item is retained, and the generation moves (SYNC.md §8, §10; STORAGE §12)",
  "store": {
    "collections": [{ "id": "INBOX", "account": null, "kind": "message/rfc822", "conflict": "manual", "generation": 1 }],
    "objects": { "m1": { "body": "fixtures/mail-basic.eml" }, "m2": { "body": "fixtures/mail-recent.eml" }, "m3": { "body": "fixtures/mail-attachment.eml" } },
    "items": [
      { "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 0 },
      { "collection": "INBOX", "link_id": "recent-1@example.org", "seq": 2, "flags": ["\\Flagged"], "object": "m2", "level": 2, "deleted": 0 },
      { "collection": "INBOX", "link_id": "attach-1@example.org", "seq": 3, "flags": [], "object": "m3", "level": 2, "deleted": 0 }
    ],
    "bindings": [
      { "collection": "INBOX", "link_id": "basic-1@example.org", "source": "imap", "handle": "1", "base_flags": ["\\Seen"], "base_object": "m1", "base_revision": null, "base_present": 1 },
      { "collection": "INBOX", "link_id": "recent-1@example.org", "source": "imap", "handle": "2", "base_flags": ["\\Flagged"], "base_object": "m2", "base_revision": null, "base_present": 1 },
      { "collection": "INBOX", "link_id": "attach-1@example.org", "source": "imap", "handle": "3", "base_flags": [], "base_object": "m3", "base_revision": null, "base_present": 1 }
    ],
    "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c0" }]
  },
  "run": { "verb": "rekey", "collection": "INBOX", "source": "imap" },
  "remote": {
    "snapshot": {
      "items": [
        { "handle": "1", "flags": ["\\Flagged"], "revision": null, "meta": { "body": "fixtures/mail-recent.eml" } },
        { "handle": "2", "flags": [], "revision": null, "meta": { "body": "fixtures/mail-attachment.eml" } }
      ],
      "vanished": [],
      "complete": true,
      "checkpoint": "d0"
    },
    "fetch": {}
  },
  "expect": {
    "pushes": [],
    "outcomes": [],
    "events": [],
    "store": {
      "collections": [{ "id": "INBOX", "account": null, "kind": "message/rfc822", "conflict": "manual", "generation": 2 }],
      "items": [
        { "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 1, "retained": true, "retained_by": "imap" },
        { "collection": "INBOX", "link_id": "recent-1@example.org", "seq": 2, "flags": ["\\Flagged"], "object": "m2", "level": 2, "deleted": 0 },
        { "collection": "INBOX", "link_id": "attach-1@example.org", "seq": 3, "flags": [], "object": "m3", "level": 2, "deleted": 0 }
      ],
