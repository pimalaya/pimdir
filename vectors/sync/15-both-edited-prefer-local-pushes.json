{
  "label": "both sides edited under prefer-local pushes the local body gated on the observed revision",
  "note": "the precondition is the revision the enumeration reported, r2, never the stale base; accepted with r3, the base moves to the local body at r3 (SYNC.md §5)",
  "store": {
    "collections": [{ "id": "Contacts", "account": null, "kind": "text/vcard", "conflict": "manual" }],
    "objects": {
      "c1": { "body": "fixtures/card-basic.vcf" },
      "c2": { "body": "fixtures/card-basic-edited.vcf" }
    },
    "items": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 }],
    "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c1", "base_revision": "r1", "base_present": 1 }],
    "probes": [],
    "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d0" }]
  },
  "run": {
    "verb": "sync",
    "collection": "Contacts",
    "source": "dav",
    "options": {
      "push": true,
      "rights": { "flags": true, "content": true, "add": true, "remove": true },
      "conflict": "prefer-local"
    }
  },
  "remote": {
    "snapshot": {
      "items": [{ "handle": "a.vcf", "flags": [], "revision": "r2" }],
      "vanished": [],
      "complete": true,
      "checkpoint": "d1"
    },
    "fetch": {}
  },
  "expect": {
    "pushes": [{ "kind": "Update", "handle": "a.vcf", "object": "c2", "if_match": "r2", "key": "807e1f03afcfd042" }],
    "outcomes": [{ "handle": "a.vcf", "outcome": "Accepted", "revision": "r3" }],
    "events": [],
    "store": {
      "items": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 }],
      "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c2", "base_revision": "r3", "base_present": 1 }],
      "probes": [],
      "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d1" }]
    }
  }
}
