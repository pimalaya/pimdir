    "events": [],
    "store": {
      "items": [{ "collection": "INBOX", "link_id": "basic-1@example.org", "seq": 1, "flags": ["\\Seen"], "object": "m1", "level": 2, "deleted": 1, "retained": true, "retained_by": "imap" }],
      "bindings": [],
      "probes": [],
      "sources": [{ "collection": "INBOX", "source": "imap", "checkpoint": "c1" }]
    }
  }
