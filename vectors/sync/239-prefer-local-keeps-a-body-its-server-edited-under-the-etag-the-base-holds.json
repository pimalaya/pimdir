{
  "v": 11,
  "label": "under prefer-local, a listing carrying another body at the revision the base holds, over a local edit, keeps that body before pushing over it",
  "note": "the store of 238 under prefer-local. The carried c3 at r1, the base's own revision, is a remote edit, so prefer-local settles a both-changed case: in a write committed before the push the base adopts c3 at r1 and c3 is kept as a retained item under the key minted over the handle, reported Overruled; c2 is then pushed gated on r1, the observed revision, accepted at r2. Reading the revision alone would push the same change and lose c3 unkept (SYNC.md sections 5 and 9; vector 117 the same case at a moved revision)",
  "store": {
    "collections": [{ "id": "Contacts", "account": null, "kind": "text/vcard", "conflict": "manual" }],
    "objects": { "c1": { "body": "fixtures/card-basic.vcf" }, "c2": { "body": "fixtures/card-basic-edited.vcf" }, "c3": { "body": "fixtures/card-basic-renamed.vcf" } },
    "items": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 }],
    "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c1", "base_revision": "r1", "base_present": 1 }],
    "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d0" }]
  },
  "run": { "verb": "sync", "collection": "Contacts", "source": "dav", "options": { "push": true, "rights": { "flags": true, "content": true, "add": true, "remove": true }, "conflict": "prefer-local" } },
  "remote": {
    "snapshot": {
      "items": [{ "handle": "a.vcf", "flags": [], "revision": "r1", "carries": true, "meta": { "body": "fixtures/card-basic-renamed.vcf" } }],
      "vanished": [],
      "complete": true,
      "checkpoint": "d1"
    },
    "fetch": {}
  },
  "expect": {
    "pushes": [{ "kind": "Update", "handle": "a.vcf", "object": "c2", "if_match": "r1", "key": "807e1f03afcfd042" }],
    "outcomes": [{ "handle": "a.vcf", "outcome": "Accepted", "revision": "r2" }],
    "events": [{ "kind": "Overruled", "handle": "a.vcf", "link_id": "dup:urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40#a.vcf" }],
    "store": {
      "items": [
        { "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "seq": 1, "flags": [], "object": "c2", "level": 2, "deleted": 0 },
        { "collection": "Contacts", "link_id": "dup:urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40#a.vcf", "seq": 2, "flags": [], "object": "c3", "level": 2, "deleted": 1, "retained": true, "retained_by": "dav", "sort_key": "jane doe-smith" }
      ],
      "bindings": [{ "collection": "Contacts", "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "source": "dav", "handle": "a.vcf", "base_flags": [], "base_object": "c2", "base_revision": "r2", "base_present": 1 }],
      "sources": [{ "collection": "Contacts", "source": "dav", "checkpoint": "d1" }]
    }
  }
}
