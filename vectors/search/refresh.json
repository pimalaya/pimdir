{
  "v": 4,
  "note": "a refresh driven by the change feed (STORAGE.md section 4.5, SEARCH.md section 4): each case builds its store as store.json's are built and indexes it, then applies its steps in order, each as an owner would write it. After each step the feed lists, above the cursor read before it, the items and the collections stated in changed, and the purge count moves when purged says so; a refresh then answers each query as stated, as an index rebuilt from the store as it then stands does, but in a step stating lagging, which answers its queries before the refresh. A missing stamp leaves the index answering the earlier store.",
  "cases": [
    {
      "label": "every kind of write an owner makes",
      "store": {
        "collections": [
          { "id": "work/INBOX", "account": "work", "kind": "message/rfc822" },
          { "id": "work/Archive", "account": "work", "kind": "message/rfc822" },
          { "id": "home/Contacts", "account": "home", "kind": "text/vcard" }
        ],
        "items": [
          { "collection": "work/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": [], "fixture": "fixtures/mail-basic.eml" },
          { "collection": "work/Archive", "seq": 2, "link_id": "budget-1@example.net", "flags": [], "summary": { "table": "mail_summary", "row": { "message_id": "budget-1@example.net", "in_reply_to": [], "subject": "Budget draft", "sender": "dan@example.net", "sender_name": "Dan", "date": "2026-08-10T08:00:00Z", "size": 4096, "attachment": null, "invitation": null }, "addresses": [{ "role": "from", "position": 0, "address": "dan@example.net", "name": "Dan" }], "sort_key": "2026-08-10T08:00:00Z" } },
          { "collection": "home/Contacts", "seq": 3, "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "flags": [], "fixture": "fixtures/card-basic.vcf" }
        ],
        "references": []
      },
      "steps": [
        {
          "note": "an insert takes the next stamp",
          "write": { "kind": "put", "item": { "collection": "work/INBOX", "seq": 4, "link_id": "reply-1@example.org", "flags": [], "fixture": "fixtures/mail-reply.eml" } },
          "changed": { "items": [["work/INBOX", "reply-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "id:reply-1@example.org", "hits": [["work", 4]] }
          ]
        },
        {
          "note": "a flag added to a placement, the body unchanged",
          "write": { "kind": "put", "item": { "collection": "work/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": ["\\Seen"], "fixture": "fixtures/mail-basic.eml" } },
          "changed": { "items": [["work/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "is:read", "hits": [["work", 1]] },
            { "query": "is:unread kind:mail", "hits": [["work", 2], ["work", 4]] }
          ]
        },
        {
          "note": "a body replaced under the same link id",
          "write": { "kind": "put", "item": { "collection": "home/Contacts", "seq": 3, "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "flags": [], "fixture": "fixtures/card-basic-renamed.vcf" } },
          "changed": { "items": [["home/Contacts", "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40"]], "collections": [], "purged": false },
          "queries": [
            { "query": "smith", "hits": [["home", 3]] },
            { "query": "jane", "hits": [["home", 3]] }
          ]
        },
        {
          "note": "a summary row changed under an unchanged item: its object, flags, level and sort key stay, so no trigger draws a stamp and the writer requests one (stamp_item)",
          "write": { "kind": "put", "item": { "collection": "work/Archive", "seq": 2, "link_id": "budget-1@example.net", "flags": [], "summary": { "table": "mail_summary", "row": { "message_id": "budget-1@example.net", "in_reply_to": [], "subject": "Budget final", "sender": "dan@example.net", "sender_name": "Dan", "date": "2026-08-10T08:00:00Z", "size": 4096, "attachment": null, "invitation": null }, "addresses": [{ "role": "from", "position": 0, "address": "dan@example.net", "name": "Dan" }], "sort_key": "2026-08-10T08:00:00Z" } } },
          "changed": { "items": [["work/Archive", "budget-1@example.net"]], "collections": [], "purged": false },
          "queries": [
            { "query": "subject:final", "hits": [["work", 2]] },
            { "query": "subject:draft", "hits": [] }
          ]
        },
        {
          "note": "a source's coverage moving restamps its collection and none of its items",
          "write": { "kind": "cover", "collection": "work/INBOX", "source": "mirror", "covered_since": "2026-08-01T00:00:00Z", "covered_until": null },
          "changed": { "items": [], "collections": ["work/INBOX"], "purged": false },
          "queries": [
            { "query": "collection:work/INBOX", "hits": [["work", 1], ["work", 4]] }
          ]
        },
        {
          "note": "a rename restamps every item under the new id and counts as a purge, the old keys gone",
          "write": { "kind": "rename", "collection": "work/Archive", "to": "work/Saved" },
          "changed": { "items": [["work/Saved", "budget-1@example.net"]], "collections": ["work/Saved"], "purged": true },
          "queries": [
            { "query": "collection:work/Saved", "hits": [["work", 2]] },
            { "query": "collection:work/Archive", "hits": [] },
            { "query": "subject:final", "hits": [["work", 2]] }
          ]
        },
        {
          "note": "an item every source dropped is retained: stamped, and no longer searched",
          "write": { "kind": "remove", "collection": "work/INBOX", "seq": 1 },
          "changed": { "items": [["work/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "subject:notes", "hits": [] },
            { "query": "is:read", "hits": [] }
          ]
        },
        {
          "note": "a purged item cannot carry a stamp and counts as a purge",
          "write": { "kind": "purge", "collection": "work/INBOX", "seq": 1 },
          "changed": { "items": [], "collections": [], "purged": true },
          "queries": [
            { "query": "id:basic-1@example.org", "hits": [] }
          ]
        },
        {
          "note": "the card dropped, then erased (STORAGE section 11.5): its purge and the collected body count as purges",
          "write": { "kind": "remove", "collection": "home/Contacts", "seq": 3 },
          "changed": { "items": [["home/Contacts", "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40"]], "collections": [], "purged": false },
          "queries": [
            { "query": "smith", "hits": [] }
          ]
        },
        {
          "write": { "kind": "erase", "collection": "home/Contacts", "seq": 3 },
          "changed": { "items": [], "collections": [], "purged": true },
          "queries": [
            { "query": "smith", "hits": [] },
            { "query": "kind:contact", "hits": [] },
            { "query": "kind:mail", "hits": [["work", 2], ["work", 4]] }
          ]
        }
      ]
    },
    {
      "label": "a body goes with its last placement",
      "note": "the card's first body is replaced, then the card retained: each body leaves the index with the last placement naming it, though the store still holds it, uncollected or pinned by the retained row, as an index rebuilt then would hold it (SEARCH.md section 4). objects counts the object rows a canonical index holds",
      "store": {
        "collections": [{ "id": "home/Contacts", "account": "home", "kind": "text/vcard" }],
        "items": [
          { "collection": "home/Contacts", "seq": 1, "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "flags": [], "fixture": "fixtures/card-basic.vcf" }
        ],
        "references": []
      },
      "steps": [
        {
          "write": { "kind": "put", "item": { "collection": "home/Contacts", "seq": 1, "link_id": "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40", "flags": [], "fixture": "fixtures/card-basic-renamed.vcf" } },
          "changed": { "items": [["home/Contacts", "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40"]], "collections": [], "purged": false },
          "objects": 1,
          "queries": [
            { "query": "smith", "hits": [["home", 1]] }
          ]
        },
        {
          "write": { "kind": "remove", "collection": "home/Contacts", "seq": 1 },
          "changed": { "items": [["home/Contacts", "urn:uuid:4fbe8971-0bc3-4e1f-8a2d-1c9b7f6e5d40"]], "collections": [], "purged": false },
          "objects": 0,
          "queries": [
            { "query": "smith", "hits": [] }
          ]
        }
      ]
    },
    {
      "label": "a member whose sort key moves names and bounds its thread again",
      "note": "basic-1 and follow-1, which replies to it, are one thread named after basic-1, the earlier. follow-1's date, and so its sort key, moves before basic-1's: the thread is named after follow-1 and bounded by the two dates as they stand, as an index rebuilt then would name and bound it (SEARCH.md section 9)",
      "store": {
        "collections": [{ "id": "work/INBOX", "account": "work", "kind": "message/rfc822" }],
        "items": [
          { "collection": "work/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": [], "fixture": "fixtures/mail-basic.eml" },
          { "collection": "work/INBOX", "seq": 2, "link_id": "follow-1@example.org", "flags": [], "summary": { "table": "mail_summary", "row": { "message_id": "follow-1@example.org", "in_reply_to": ["basic-1@example.org"], "subject": "Re: Stand-up notes", "sender": "bob@example.org", "sender_name": "Bob", "date": "2026-08-05T08:00:00Z", "size": 512, "attachment": null, "invitation": null }, "addresses": [{ "role": "from", "position": 0, "address": "bob@example.org", "name": "Bob" }], "sort_key": "2026-08-05T08:00:00Z" } }
        ],
        "references": []
      },
      "steps": [
        {
          "write": { "kind": "put", "item": { "collection": "work/INBOX", "seq": 2, "link_id": "follow-1@example.org", "flags": [], "summary": { "table": "mail_summary", "row": { "message_id": "follow-1@example.org", "in_reply_to": ["basic-1@example.org"], "subject": "Re: Stand-up notes", "sender": "bob@example.org", "sender_name": "Bob", "date": "2026-07-20T08:00:00Z", "size": 512, "attachment": null, "invitation": null }, "addresses": [{ "role": "from", "position": 0, "address": "bob@example.org", "name": "Bob" }], "sort_key": "2026-07-20T08:00:00Z" } } },
          "changed": { "items": [["work/INBOX", "follow-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "thread:basic-1@example.org", "threads": [{ "thread": "follow-1@example.org", "count": 2, "first": "2026-07-20T08:00:00Z", "last": "2026-08-01T10:00:00Z", "hits": [["work", 1], ["work", 2]] }] }
          ]
        }
      ]
    },
    {
      "label": "an event in a zone whose rule steps by the second is indexed within bounds",
      "note": "event-zoned-hostile.ics: its zone's DAYLIGHT rule steps every second from 1970, which an expander following every onset walks for 1.7 billion steps; STORAGE.md Annex A.3 and SEARCH.md section 7 bound the periods a rule is followed for, so indexing the event ends and it answers by the fields it states, its title and its kind; the instant a zone this hostile resolves to is the implementation's own and no query here reads it (SEARCH.md section 7)",
      "store": {
        "collections": [{ "id": "home/Calendar", "account": "home", "kind": "text/calendar" }],
        "items": [
          { "collection": "home/Calendar", "seq": 1, "link_id": "event-hostile-zone@example.org", "flags": [], "fixture": "fixtures/event-zoned-hostile.ics" }
        ],
        "references": []
      },
      "steps": [
        {
          "write": { "kind": "cover", "collection": "home/Calendar", "source": "mirror", "covered_since": null, "covered_until": null },
          "changed": { "items": [], "collections": ["home/Calendar"], "purged": false },
          "objects": 1,
          "queries": [
            { "query": "stepping", "hits": [["home", 1]] },
            { "query": "kind:event", "hits": [["home", 1]] }
          ]
        }
      ]
    },
    {
      "label": "an item keeps local state",
      "note": "properties (STORAGE section 4.3) are applied by the owner from set-property actions (section 15.3), keyed by the seq, read from the store by label: and property:, never copied into the index; a change stamps every row holding the seq, a change that moves no row stamps nothing",
      "store": {
        "collections": [
          { "id": "home/INBOX", "account": "home", "kind": "message/rfc822" },
          { "id": "work/INBOX", "account": "work", "kind": "message/rfc822" }
        ],
        "items": [
          { "collection": "home/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": [], "fixture": "fixtures/mail-basic.eml" },
          { "collection": "work/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": [], "fixture": "fixtures/mail-basic.eml" },
          { "collection": "home/INBOX", "seq": 2, "link_id": "reply-1@example.org", "flags": [], "fixture": "fixtures/mail-reply.eml" }
        ],
        "references": [],
        "properties": [
          { "seq": 2, "key": "himalaya/snooze-until", "value": "2026-12-01T09:00:00Z" }
        ]
      },
      "steps": [
        {
          "note": "a label added stamps every row holding the item's seq, in both accounts (STORAGE section 4.5)",
          "write": { "kind": "property", "collection": "home/INBOX", "seq": 1, "key": "pimdir/label", "add": ["Receipts"] },
          "changed": { "items": [["home/INBOX", "basic-1@example.org"], ["work/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "label:receipts", "hits": [["home", 1], ["work", 1]] },
            { "query": "property:pimdir/label=Receipts", "hits": [["home", 1], ["work", 1]] }
          ]
        },
        {
          "note": "a label whose fold the item holds already adds nothing and stamps nothing (STORAGE section 15.3), queued on the other collection",
          "write": { "kind": "property", "collection": "work/INBOX", "seq": 1, "key": "pimdir/label", "add": ["RECEIPTS"] },
          "changed": { "items": [], "collections": [], "purged": false },
          "queries": [
            { "query": "property:pimdir/label=RECEIPTS", "hits": [] },
            { "query": "label:receipts", "hits": [["home", 1], ["work", 1]] }
          ]
        },
        {
          "note": "respelled: the remove takes the label whose fold is its own, then the add writes the new spelling",
          "write": { "kind": "property", "collection": "home/INBOX", "seq": 1, "key": "pimdir/label", "remove": ["receipts"], "add": ["receipts"] },
          "changed": { "items": [["home/INBOX", "basic-1@example.org"], ["work/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "property:pimdir/label=receipts", "hits": [["home", 1], ["work", 1]] },
            { "query": "property:pimdir/label=Receipts", "hits": [] }
          ]
        },
        {
          "note": "a value the item does not hold, removed, changes nothing",
          "write": { "kind": "property", "collection": "home/INBOX", "seq": 1, "key": "pimdir/label", "remove": ["Tax returns"] },
          "changed": { "items": [], "collections": [], "purged": false },
          "queries": [
            { "query": "label:\"tax returns\"", "hits": [] }
          ]
        },
        {
          "note": "one row retained: its item keeps its properties, read from the live row alone",
          "write": { "kind": "remove", "collection": "work/INBOX", "seq": 1 },
          "changed": { "items": [["work/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "label:receipts", "hits": [["home", 1]] }
          ]
        },
        {
          "note": "that row purged: another row holds the seq, so the properties stay",
          "write": { "kind": "purge", "collection": "work/INBOX", "seq": 1 },
          "changed": { "items": [], "collections": [], "purged": true },
          "queries": [
            { "query": "label:receipts", "hits": [["home", 1]] }
          ]
        },
        {
          "note": "an application's own value removed",
          "write": { "kind": "property", "collection": "home/INBOX", "seq": 2, "key": "himalaya/snooze-until", "remove": ["2026-12-01T09:00:00Z"] },
          "changed": { "items": [["home/INBOX", "reply-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "property:himalaya/snooze-until=2026-12-01T09:00:00Z", "hits": [] },
            { "query": "id:reply-1@example.org", "hits": [["home", 2]] }
          ]
        }
      ]
    },
    {
      "label": "a system flag is read from the store as it stands",
      "note": "is: and a tag: naming a system flag read the store's items.marks when the query runs (SEARCH.md section 8.2), never the index, so a step stating lagging, answered before the refresh with the index one write behind, answers the flags the write left; a keyword is read from the index's flag table, once refreshed",
      "store": {
        "collections": [
          { "id": "home/INBOX", "account": "home", "kind": "message/rfc822" },
          { "id": "home/Archive", "account": "home", "kind": "message/rfc822" }
        ],
        "items": [
          { "collection": "home/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": [], "fixture": "fixtures/mail-basic.eml" },
          { "collection": "home/Archive", "seq": 1, "link_id": "basic-1@example.org", "flags": [], "fixture": "fixtures/mail-basic.eml" },
          { "collection": "home/INBOX", "seq": 2, "link_id": "reply-1@example.org", "flags": ["\\Seen"], "fixture": "fixtures/mail-reply.eml" }
        ],
        "references": []
      },
      "steps": [
        {
          "note": "a message marked read and flagged in one of its two collections, answered before the refresh: no longer unread, since a placement holds the bit, and flagged",
          "lagging": true,
          "write": { "kind": "put", "item": { "collection": "home/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": ["\\Seen", "\\Flagged"], "fixture": "fixtures/mail-basic.eml" } },
          "changed": { "items": [["home/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "is:read", "hits": [["home", 1], ["home", 2]] },
            { "query": "is:unread", "hits": [] },
            { "query": "is:flagged", "hits": [["home", 1]] },
            { "query": "tag:\\Flagged", "hits": [["home", 1]] }
          ]
        },
        {
          "note": "the reply marked unread, answered before the refresh",
          "lagging": true,
          "write": { "kind": "put", "item": { "collection": "home/INBOX", "seq": 2, "link_id": "reply-1@example.org", "flags": [], "fixture": "fixtures/mail-reply.eml" } },
          "changed": { "items": [["home/INBOX", "reply-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "is:unread", "hits": [["home", 2]] },
            { "query": "is:read kind:mail", "hits": [["home", 1]] }
          ]
        },
        {
          "note": "a keyword added, answered after the refresh: the keyword from the index, the system flags from the store, a text term beside them",
          "write": { "kind": "put", "item": { "collection": "home/INBOX", "seq": 1, "link_id": "basic-1@example.org", "flags": ["\\Seen", "\\Flagged", "$todo"], "fixture": "fixtures/mail-basic.eml" } },
          "changed": { "items": [["home/INBOX", "basic-1@example.org"]], "collections": [], "purged": false },
          "queries": [
            { "query": "tag:$todo", "hits": [["home", 1]] },
            { "query": "tag:$todo is:flagged", "hits": [["home", 1]] },
            { "query": "stand-up is:read", "hits": [["home", 1]] },
            { "query": "stand-up is:unread", "hits": [] }
          ]
        }
      ]
    }
  ]
