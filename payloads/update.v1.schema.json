{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/payloads/update.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "title": "The payload of an update at v 1 (STORAGE.md section 15.3)",
  "type": "object",
  "required": ["v", "seq", "object"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "object": { "type": "string", "pattern": "^[a-z2-7]{52}$" },
    "if_match": { "type": "string", "pattern": "^[a-z2-7]{52}$" }
  }
}
