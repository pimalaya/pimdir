{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/payloads/set-property.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "title": "The payload of a set-property at v 1 (STORAGE.md section 15.3); a value's bound in bytes of UTF-8 is the text's",
  "type": "object",
  "required": ["v", "seq", "key"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "key": { "type": "string", "maxLength": 64, "pattern": "^(pimdir/label|(?!pimdir/)[a-z0-9._-]+/[a-z0-9._-]+)$" },
    "add": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000]+$" } },
    "remove": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000]+$" } }
  },
  "anyOf": [{ "required": ["add"] }, { "required": ["remove"] }]
}
