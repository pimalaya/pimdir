{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pimalaya/pimdir/payloads/set-performer.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "title": "The payload of a set-performer at v 1 (STORAGE.md section 15.3)",
  "type": "object",
  "required": ["v", "capability"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$" },
    "source": { "type": "string", "minLength": 1 }
  }
}
